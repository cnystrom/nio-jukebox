#include "nio_lib.h"

int
main(int argc, char *argv[])
{
  string s;
  char server[MAXHOSTNAMELEN];

  if (argc < 2)
    strcpy(server, "localhost");
  else
   strcpy(server, argv[1]);

  nio_app_init(server, "play_test", "0.1");

  nio_color_foreground(255, 0, 0);
//  nio_font_set("-adobe-helvetica-bold-i-normal-*-14-*-*-*-*-*-iso8859-1");

  nio_print("\nNIO Play Test version 0.01\n\n");

  while(TRUE)
  {
    nio_print("Enter text to play [exit to quit]: ");
    nio_gets(s);

    if (strcmp(s, "exit") == 0)
    {
      nio_print("NIO String Test exiting...\n");
      nio_exit();
      exit(0);
    }

    nio_printf("\nPlaying: %s\n\n", s);
    nio_play_music(s);
  }
 
}
